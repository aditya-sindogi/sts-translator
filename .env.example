# Copy to .env and edit. Every setting is in app/config.py (env var = STS_ + name).

# LLM (any OpenAI-compatible server). Default: Ollama on this machine.
STS_LLM_BASE_URL=http://localhost:11434/v1
STS_LLM_MODEL=gemma4:12b

# Speech-to-text: spoken language -> engine (app/stt/providers.py)
STS_STT='{"en": "parakeet"}'
STS_STT_FALLBACK=moonshine

# Text-to-speech: language of the text -> "provider:voice" (app/tts/providers.py)
STS_TTS='{"en": "kokoro:af_heart"}'

# Languages a document can be translated into
STS_SUPPORTED_LANGUAGES='["en", "hi", "ur", "bho"]'
