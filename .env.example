# LLM: Ollama locally; for vLLM use e.g. http://gpu-host:8000/v1 and the HF model id
STS_LLM_BASE_URL=http://localhost:11434/v1
STS_LLM_MODEL=gemma4:12b
STS_LLM_EXTRA_BODY={"reasoning_effort": "none"}

# STT: auto | mlx (Apple Silicon) | nemo (Linux + NVIDIA GPU)
STS_STT_BACKEND=auto
STS_STT_MOONSHINE_FALLBACK=true

# Spoken language ID
STS_LID_REJECT_CONFIDENCE=0.70
STS_SUPPORTED_LANGUAGES=["en"]

# TTS
STS_KOKORO_VOICE=af_heart
