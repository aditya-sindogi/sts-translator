# EC2 (Linux + NVIDIA GPU) configuration. Read by the app (pydantic) and by bash
# (`source`), so keep values with spaces or JSON in single quotes.
# `deploy/setup.sh` copies this to `.env`
# in the repo root and fills in VLLM_API_KEY / STS_LLM_API_KEY.

# ---------- App ----------
STS_HOST=127.0.0.1            # reach it through: ssh -L 7860:localhost:7860 <ec2>
STS_PORT=7860

# LLM: Gemma 4 12B served by vLLM on this GPU (never the laptop's Ollama)
STS_LLM_BASE_URL=http://127.0.0.1:8000/v1
STS_LLM_MODEL=google/gemma-4-12B-it
STS_LLM_API_KEY=__GENERATED__
STS_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
STS_LLM_REQUIRED=true         # refuse to start if vLLM isn't up

# STT: Parakeet on the GPU via NeMo (Moonshine CPU fallback stays on)
STS_STT_BACKEND=nemo

# WebRTC: STUN so the instance advertises its public IP for audio
STS_ICE_SERVERS='["stun:stun.l.google.com:19302"]'

# Optional: the team's Indic ASR / TTS servers (leave empty to disable)
STS_INDIC_ASR_URL=
STS_INDIC_TTS_URL=
STS_SPEECH_LANGUAGES='["en"]'

# ---------- vLLM (read by deploy/start.sh) ----------
VLLM_VENV=$HOME/.venvs/vllm
VLLM_MODEL=google/gemma-4-12B-it
VLLM_PORT=8000
VLLM_API_KEY=__GENERATED__
VLLM_MAX_MODEL_LEN=32768
# L40S has 46 GB: ~0.70 leaves ~13 GB for Parakeet/NeMo and headroom.
VLLM_GPU_MEMORY_UTILIZATION=0.70
