# EC2 settings. Everything else uses the same defaults as the laptop
# (Ollama at localhost:11434 serving gemma4:12b).

# Parakeet speech-to-text on the NVIDIA GPU (falls back to CPU Moonshine if it can't load)
STS_PARAKEET_BACKEND=nemo

# Refuse to start if Ollama/Gemma isn't reachable
STS_LLM_REQUIRED=true

# Which service handles each language (see README, "Swapping STT and TTS"):
# STS_STT='{"en": "parakeet", "hi": "indic_zipformer"}'
# STS_TTS='{"en": "kokoro:af_heart", "hi": "kokoro:hf_alpha"}'
